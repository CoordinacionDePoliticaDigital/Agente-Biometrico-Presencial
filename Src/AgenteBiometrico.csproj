<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AgenteBiometricoPresencial</RootNamespace>
    <AssemblyName>AgenteBiometricoPresencial</AssemblyName>
    <Version>2.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Dependencias NuGet -->
  <ItemGroup>
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- System.Management provee ManagementObjectSearcher para consultar WMI/USB en Windows -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Referencia al ensamblado Managed de RealPassSDK (opcional, solo si está instalado) -->
  <ItemGroup Condition="Exists('C:\Program Files\Xperix\RealPassSDK\Bin\x64\Xperix.RealPassSDK.dll')">
    <Reference Include="Xperix.RealPassSDK">
      <HintPath>C:\Program Files\Xperix\RealPassSDK\Bin\x64\Xperix.RealPassSDK.dll</HintPath>
      <!-- No copiar la DLL al output; debe estar en su ruta de instalación -->
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
