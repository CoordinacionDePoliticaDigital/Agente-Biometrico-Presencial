<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseSystemDrawing>true</UseSystemDrawing>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AgenteBiometricoPresencial</RootNamespace>
    <AssemblyName>AgenteBiometricoPresencial</AssemblyName>
    <ApplicationIcon>Assets\agent-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Assets\agent-icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Program.cs" Link="Program.cs" />
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- Referencia al ensamblado Managed de RealPassSDK si está presente en C:\Program Files\Xperix -->
  <ItemGroup Condition="Exists('C:\Program Files\Xperix\RealPassSDK\Bin\x64\Xperix.RealPassSDK.dll')">
    <Reference Include="Xperix.RealPassSDK">
      <HintPath>C:\Program Files\Xperix\RealPassSDK\Bin\x64\Xperix.RealPassSDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Configuration\document-templates\*.json" Link="Configuration\document-templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Condition="Exists('C:\Program Files\Xperix\RealPassSDK\Bin\x64\data\face\haarcascade_frontalface_alt2.xml')"
          Include="C:\Program Files\Xperix\RealPassSDK\Bin\x64\data\face\haarcascade_frontalface_alt2.xml"
          Link="Assets\haarcascade_frontalface_alt2.xml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Condition="Exists('C:\Program Files\Xperix\RealPassSDK\Bin\x64\data\tessdata\OCRB.traineddata')"
          Include="C:\Program Files\Xperix\RealPassSDK\Bin\x64\data\tessdata\OCRB.traineddata"
          Link="tessdata\OCRB.traineddata"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
